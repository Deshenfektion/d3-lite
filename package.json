{
  "name": "d3-lite",
  "version": "0.1.0",
  "description": "A lightweight, D3-inspired visualization engine built from scratch to explore the internals of modern charting libraries.",
  "type": "module",
  "license": "MIT",
  "author": "Deshen Rao <deshen.r1502@gmail.com>",
  "keywords": [
    "visualization",
    "charts",
    "svg",
    "canvas",
    "scales",
    "dataviz",
    "scenegraph"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.examples.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:examples": "vite build --config vite.examples.config.ts",
    "preview": "vite preview --config vite.examples.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "bench:report": "tsx bench/run.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "9.26.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.15.3",
    "@vitest/coverage-v8": "3.1.3",
    "eslint": "9.26.0",
    "eslint-config-prettier": "10.1.2",
    "globals": "16.0.0",
    "jsdom": "26.1.0",
    "prettier": "3.5.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.0",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  }
}
